      "name": "LoginTest_PositiveTest",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log(\"Running positive test\")\r",
              "var responseBody=pm.response.json();\r",
              "\r",
              "const jsonSchema={\r",
              "  \"type\": \"object\",\r",
              "  \"properties\": {\r",
              "    \"message\": {\r",
              "      \"type\": \"string\"\r",
              "    },\r",
              "    \"data\": {\r",
              "      \"type\": \"object\",\r",
              "      \"properties\": {\r",
              "        \"token\": {\r",
              "          \"type\": \"string\"\r",
              "        }\r",
              "      },\r",
              "      \"required\": [\r",
              "        \"token\"\r",
              "      ]\r",
              "    }\r",
              "  },\r",
              "  \"required\": [\r",
              "    \"message\",\r",
              "    \"data\"\r",
              "  ]\r",
              "}\r",
              "\r",
              "pm.test(\"Status code should be 200\",function(){\r",
              "    pm.response.to.have.status(200);\r",
              "})\r",
              "\r",
              "pm.test(\"Message should be Success\",function(){\r",
              "    pm.expect(pm.response.json().message).to.eql(\"Success\")\r",
              "})\r",
              "\r",
              "pm.test(\"Response time is under 1000ms\",function(){\r",
              "    pm.expect(pm.response.responseTime).to.be.below(150)\r",
              "})\r",
              "\r",
              "pm.test(\"Validate json schema\",function(){\r",
              "    pm.response.to.have.jsonSchema(jsonSchema)\r",
              "})\r",
              "\r",
              "pm.test(\"Verify the token is not null\",function(){\r",
              "    pm.expect(responseBody.data.token).to.be.not.null\r",
              "})\r",
              "\r",
              "pm.test(\"Verify if the token is valid\", function() {\r",
              "    var token = pm.response.json().data.token;\r",
              "    pm.expect(token.split('.')).to.have.length(3); \r",
              "    pm.collectionVariables.set(\"fdtoken\",token)\r",
              "});\r",
              ""
            ],
